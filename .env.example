# multi-cms backend URL (Render veya lokal)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Filament'teki Site.domain ile birebir aynı olmalı.
# Lokal test için: backend'de bir Site açıp domain'i "site-c.local" yap, ya da DemoSeeder'ı genişlet.
SITE_DOMAIN=site-c.local

# Filament'teki Site.revalidate_secret ile aynı.
# Üret: openssl rand -hex 32
REVALIDATE_SECRET=change-me-to-a-long-random-string
